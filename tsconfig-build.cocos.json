{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "declaration": true,
        "declarationDir": "./dist",
        "outDir": "./dist",
        "lib": [
            "ES2017",
            "DOM"
        ],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "./test/",
        "./node_modules/",
        "./dist/",
        "./index.js"
    ]
}